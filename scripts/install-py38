#!/bin/sh -e

set -x

# Python 3.8/3.9 cannot use `uv sync --frozen` (`uv.lock` is locked for >= 3.10),
# and several runtime/test dependencies have no PyPI release supporting these
# interpreters. Install the py38deps backport wheels (same versions, widened
# `requires-python`) from the py38deps package index, then the project and the
# test dependencies explicitly. Linting and packaging are skipped for these
# interpreters in CI.
#
# Usage: scripts/install-py38 [path-to-python]

PYTHON="${1:-python}"

# PyPI stays the primary index; the extra index serves the backports.
export PIP_EXTRA_INDEX_URL="https://py38deps.github.io/py38deps/simple/"

# Dependencies without a 3.8/3.9-compatible PyPI release. `httpx2` pins
# `httpcore2` to the matching backport.
"$PYTHON" -m pip install \
    "anyio>=4.10" \
    "typing_extensions>=4.16.0" \
    "truststore>=0.10" \
    "idna>=3.18" \
    "trio>=0.34.0,<1.0" \
    "python-multipart" \
    "httpx2[zstd]>=2.0.0"

# The project itself, with the extras the test suite exercises.
"$PYTHON" -m pip install -e ".[full]"

# Test dependencies. `coverage[toml]` 7.6.1 is the last release supporting 3.8.
"$PYTHON" -m pip install \
    "pytest>=8.3.5,<9" \
    "pytest-cov>=5,<6" \
    "coverage[toml]==7.6.1" \
    "importlib-metadata>=8.5.0,<9"
